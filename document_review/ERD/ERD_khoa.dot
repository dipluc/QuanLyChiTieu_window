digraph ERD {
graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.5, ranksep=1.1, splines=spline, outputorder=edgesfirst, fontname="Arial", label="ERD — QUẢN LÝ CHI TIÊU CÁ NHÂN\n12 bảng • 22 khóa ngoại | PK: khóa chính · FK: khóa ngoại · ?: cho phép NULL\nĐọc mỗi đường: phía bảng cha → phía bảng con (0..N hoặc 0..1)", labelloc=t, fontsize=23];
node [shape=plain,fontname="Arial"];
edge [fontname="Arial",fontsize=11,arrowsize=0.7,color="#526477",fontcolor="#30445c"];
